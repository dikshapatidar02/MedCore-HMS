[Unit]
Description=MedCore HMS API Backend Service (NestJS)
Documentation=https://github.com/medcore-hms/medcore-hms
After=network.target postgresql.service redis.service

[Service]
Type=simple
User=medcore
Group=medcore
WorkingDirectory=/opt/medcore-hms/backend
EnvironmentFile=/opt/medcore-hms/.env.production
ExecStartPre=/usr/bin/node /opt/medcore-hms/backend/node_modules/.bin/prisma migrate deploy
ExecStart=/usr/bin/node /opt/medcore-hms/backend/dist/main.js
Restart=always
RestartSec=5
StandardOutput=append:/var/log/medcore/api.log
StandardError=append:/var/log/medcore/api-error.log

# Security Hardening Directives (systemd)
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/medcore-hms/backend/uploads /var/log/medcore
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
AmbientCapabilities=CAP_NET_BIND_SERVICE

# Resource Limits
LimitNOFILE=65535
MemoryHigh=1800M
MemoryMax=2048M

[Install]
WantedBy=multi-user.target
