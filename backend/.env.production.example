# ==============================================================================
# MedCore HMS — Production Environment Configuration (₹0 Free Tier Template)
# ==============================================================================
# IMPORTANT:
# - Do NOT commit real secrets or credentials to source control.
# - Supply these values in your cloud host dashboard (e.g., Render, Railway, Fly.io).
# - Generate high-entropy secrets using: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ==============================================================================

NODE_ENV=production
PORT=3001

# Production PostgreSQL Database
# Recommended Free Tier: Supabase (500 MB) or Neon (Serverless PostgreSQL)
# Example: postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres?sslmode=require
DATABASE_URL=postgresql://user:password@host:5432/database?sslmode=require

# Cryptographic JWT Signing Secrets (>= 32 hex characters / 256-bit entropy)
JWT_ACCESS_SECRET=generate_with_crypto_randomBytes_32_hex_string
JWT_REFRESH_SECRET=generate_with_crypto_randomBytes_32_hex_string

# Authoritative Frontend URL for CORS Origin Whitelist (e.g., your Vercel deployment)
FRONTEND_URL=https://medcore-hms.vercel.app

# Public Backend URL (used for absolute callbacks, webhooks, or attachment download links)
BACKEND_URL=https://medcore-api.onrender.com

# Cache & Queues (Optional for ₹0 plan - application operates safely without Redis)
# Recommended Free Tier: Upstash Redis (Serverless, 10,000 commands/day free)
# REDIS_URL=rediss://default:password@region.upstash.io:6379
# REDIS_HOST=
# REDIS_PORT=6379
# REDIS_PASSWORD=

# Document Storage Driver (Defaults to 'local' if AWS is unconfigured)
# STORAGE_DRIVER=local

# Sentry Telemetry (Optional)
# SENTRY_DSN=

