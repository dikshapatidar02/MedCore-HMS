# Copy to .env for local development. Never commit real secrets.
POSTGRES_DB=medcore
POSTGRES_USER=medcore_user
POSTGRES_PASSWORD=replace_with_a_long_local_password
POSTGRES_PORT=5432
REDIS_PORT=6379
DATABASE_URL=postgresql://medcore_user:replace_with_a_long_local_password@localhost:5432/medcore?schema=public
REDIS_URL=redis://localhost:6379
JWT_ACCESS_SECRET=replace_with_at_least_32_random_bytes
JWT_REFRESH_SECRET=replace_with_a_different_32_random_bytes
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:3001
