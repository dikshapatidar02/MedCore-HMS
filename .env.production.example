# ==============================================================================
# MedCore HMS — Production Environment Configuration Template
# Target: ₹0 Zero-Cost Cloud Deployment (Vercel Frontend + Render API + Neon PostgreSQL)
#
# IMPORTANT SECURITY RULES:
# 1. NEVER commit real production secrets, passwords, or credentials to git.
# 2. Add these variables directly in the Vercel and Render web dashboards.
# 3. For ₹0 deployment, NEVER attach a credit card or payment method to any provider.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE APPLICATION ENVIRONMENT
# ------------------------------------------------------------------------------
NODE_ENV=production

# Render automatically sets PORT=10000; defaults to 3001 locally
PORT=10000

# ------------------------------------------------------------------------------
# 2. AUTHORITATIVE URLS (CORS & FRONTEND-BACKEND INTEGRATION)
# ------------------------------------------------------------------------------
# Set FRONTEND_URL in Render Dashboard to your Vercel public URL
FRONTEND_URL=https://medcore-hms.vercel.app

# Set BACKEND_URL in Render Dashboard to your Render public URL
BACKEND_URL=https://medcore-api.onrender.com/api/v1

# Set NEXT_PUBLIC_API_URL in Vercel Dashboard to point to Render
NEXT_PUBLIC_API_URL=https://medcore-api.onrender.com/api/v1

# ------------------------------------------------------------------------------
# 3. DATABASE CONFIGURATION (Neon Serverless PostgreSQL — Free Tier)
# ------------------------------------------------------------------------------
# Format from Neon Console (Connection Details -> Prisma or Pooled connection):
# postgresql://<user>:<password>@<endpoint>.neon.tech/medcore?sslmode=require
DATABASE_URL=postgresql://medcore_owner:REPLACE_WITH_NEON_PASSWORD@ep-solitary-voice-xxxxxx.us-east-2.aws.neon.tech/medcore?sslmode=require

# ------------------------------------------------------------------------------
# 4. JWT AUTHENTICATION SECRETS (Must be >= 32 cryptographically secure random bytes)
# ------------------------------------------------------------------------------
# Generate via: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_ACCESS_SECRET=REPLACE_WITH_HEX_ENCODED_32_BYTE_ACCESS_SECRET
JWT_REFRESH_SECRET=REPLACE_WITH_HEX_ENCODED_32_BYTE_REFRESH_SECRET
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN_DAYS=7

# ------------------------------------------------------------------------------
# 5. ZERO-COST FALLBACKS (NO PAID EXTERNAL ACCOUNTS REQUIRED)
# ------------------------------------------------------------------------------
# Background Reminders:
# Leave REDIS_HOST unset. MedCore's ReminderQueueService automatically runs in
# safe in-memory Node.js scheduler fallback mode at ₹0 cost (zero Redis connections).
# REDIS_HOST=

# File Storage:
# Leave AWS_S3_BUCKET_NAME unset. MedCore's StorageService automatically stores
# diagnostic attachments on local disk (uploads/ directory) at ₹0 cost.
# AWS_S3_BUCKET_NAME=

# Error Observability:
# Leave SENTRY_DSN unset. MedCore's SentryMonitoringInterceptor automatically
# outputs structured JSON logs to the console with full PHI/PII redaction at ₹0 cost.
# SENTRY_DSN=

# ------------------------------------------------------------------------------
# 6. OPTIONAL PAYMENT GATEWAY MOCK CREDENTIALS (DEMO MODE)
# ------------------------------------------------------------------------------
# Leave blank or use sandbox test keys (never live sk_live_ keys in demo)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
